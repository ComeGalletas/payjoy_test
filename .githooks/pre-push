#!/bin/sh
# pre-push: never push to main (GR-013), then run the quality gate (`make check`).
# git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.

remote_name="$1"

while read -r local_ref local_sha remote_ref remote_sha || [ -n "$local_ref" ]; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo "pre-push: rejected push of $local_ref to $remote_name main (GR-013)." >&2
        echo "  Push a branch and open a pull request instead." >&2
        exit 1
    fi
done

echo "pre-push: running make check"
if ! make check; then
    echo "pre-push: make check failed; push blocked. Fix the failures and push again." >&2
    exit 1
fi
