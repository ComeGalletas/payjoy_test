#!/bin/sh
# fx-installments managed hook
# commit-msg: enforce the subject convention from CLAUDE.md, "<ID>: <imperative summary>".
# <ID> is a work ID from docs/PLAN.md section 10: P<phase>-<nn> (for example P1-03) or L-<nn>.
# The summary needs at least one non-whitespace character.
# Also allowed: git's own merge subjects ("Merge branch ...", "Merge pull request ...", ...)
# and revert/reapply subjects ('Revert "...', 'Reapply "...').

msg_file="$1"

if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
    echo "commit-msg: no commit message file given" >&2
    exit 1
fi

# Drop CRs, then everything from git's scissors line on (`git commit -v` puts the diff below
# it), then comment and blank lines. The subject is the first line left.
subject=$(tr -d '\r' < "$msg_file" \
    | sed -e '/^# -* >8 -*$/,$d' \
    | grep -v '^#' \
    | grep -v '^[[:space:]]*$' \
    | head -n 1)

if printf '%s\n' "$subject" \
    | grep -Eq '^Merge (branch|branches|remote-tracking branch|pull request|tag|commit) |^(Revert|Reapply) "'; then
    exit 0
fi

if printf '%s\n' "$subject" | grep -Eq '^(P[0-9]-[0-9]{2}|L-[0-9]{2}): .*[^[:space:]]'; then
    exit 0
fi

cat >&2 <<EOF
commit-msg: rejected subject: "$subject"
  Expected "<ID>: <imperative summary>", for example "P1-03: Add AmountParser".
  <ID> is P<phase>-<two digits> (P0-04, P1-10) or L-<two digits> (L-01), and the summary
  must not be empty or whitespace only.
  Also allowed: git's merge subjects ("Merge branch|branches|remote-tracking branch|
  pull request|tag|commit ...") and subjects starting with 'Revert "' or 'Reapply "'.
EOF
exit 1
