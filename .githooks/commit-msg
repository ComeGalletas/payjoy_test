#!/bin/sh
# fx-installments managed hook
# commit-msg: enforce the subject convention from CLAUDE.md, "<ID>: <imperative summary>".
# <ID> is a work ID from docs/PLAN.md section 10: P<phase>-<nn> (for example P1-03) or L-<nn>.
# The summary needs at least one non-whitespace character.
# Also allowed: git's own merge subjects ("Merge branch ...", "Merge pull request ...", ...)
# and revert/reapply subjects ('Revert "...', 'Reapply "...').
#
# Comment character: `git config core.commentChar` (or core.commentString, its git 2.45+ alias;
# the last one set wins, as in git). Unset or "auto" means "#". A multi-character value is used
# as a literal prefix.
# git runs this hook before it applies its cleanup mode, and the hook can't tell which mode is in
# use: with --cleanup=verbatim (or whitespace, the default for -m and -F) a comment line stays in
# the commit as text. So a message whose first non-blank line starts with the comment character is
# always rejected; comment lines below the subject are ignored.

msg_file="$1"

if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
    echo "commit-msg: no commit message file given" >&2
    exit 1
fi

comment=$(git config --get-regexp '^core\.comment(char|string)$' 2>/dev/null \
    | tail -n 1 \
    | sed -n 's/^[^ ]* //p')
if [ -z "$comment" ] || [ "$comment" = "auto" ]; then
    comment='#'
fi

# Drop CRs, then stop at git's scissors line (`git commit -v` puts the diff below it) and skip
# blank lines. awk prints the first line left, prefixed with C when it is a comment line and with
# S otherwise. The comment string comes in through the environment, which awk reads literally.
first=$(tr -d '\r' < "$msg_file" | COMMIT_MSG_COMMENT="$comment" awk '
    BEGIN { c = ENVIRON["COMMIT_MSG_COMMENT"]; n = length(c) }
    substr($0, 1, n + 1) == c " " && substr($0, n + 2) ~ /^-* >8 -*$/ { exit }
    /^[[:space:]]*$/ { next }
    {
        if (substr($0, 1, n) == c) { print "C" $0 } else { print "S" $0 }
        exit
    }
')

subject=${first#?}

case "$first" in
C*)
    cat >&2 <<EOF
commit-msg: rejected subject: "$subject"
  The first non-blank line starts with the comment character "$comment". git may keep it as
  the subject (--cleanup=verbatim, or whitespace for -m and -F), so put the subject first.
EOF
    ;;
*)
    if printf '%s\n' "$subject" \
        | grep -Eq '^Merge (branch|branches|remote-tracking branch|pull request|tag|commit) |^(Revert|Reapply) "'; then
        exit 0
    fi

    if printf '%s\n' "$subject" | grep -Eq '^(P[0-9]-[0-9]{2}|L-[0-9]{2}): .*[^[:space:]]'; then
        exit 0
    fi

    echo "commit-msg: rejected subject: \"$subject\"" >&2
    ;;
esac

cat >&2 <<EOF
  Expected "<ID>: <imperative summary>", for example "P1-03: Add AmountParser".
  <ID> is P<phase>-<two digits> (P0-04, P1-10) or L-<two digits> (L-01), and the summary
  must not be empty or whitespace only.
  Also allowed: git's merge subjects ("Merge branch|branches|remote-tracking branch|
  pull request|tag|commit ...") and subjects starting with 'Revert "' or 'Reapply "'.
EOF
exit 1
