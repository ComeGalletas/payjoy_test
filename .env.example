# Placeholders only. Copy to .env and fill in locally; .env is never committed or read by agents.
# ExchangeRate-API key; server-side only, because it sits in the upstream URL path.
EXCHANGERATE_API_KEY=
# Bearer token for admin endpoints; when empty, every admin request is refused.
ADMIN_TOKEN=
# PDO DSN for the database. Leave it empty for the default, the SQLite file api/var/app.db.
# Set it only for another file or database, for example sqlite:api/var/demo.db (a relative
# path is read from the repository root). Only php api/bin/migrate.php creates the file.
DB_DSN=
# Database user; leave empty for SQLite.
DB_USER=
# Database password; leave empty for SQLite.
DB_PASS=
# Peer IP of a trusted reverse proxy; X-Forwarded-For is honoured only from it. Empty means none.
TRUSTED_PROXY=
# Protected data folder (GR-001); open placeholder, tests point it at a temp dir.
DATA_ROOT=
# Protected backup folder (GR-001); open placeholder, tests point it at a temp dir.
BACKUP_ROOT=
